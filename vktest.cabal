cabal-version:      3.14
name:               vktest
version:            0.1.0
license:            GPL-2.0-or-later
license-file:       LICENSE
author:             andromeda
maintainer:         @andromeda:tchncs.de
category:           Graphics
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall
executable vktest
    import:           warnings
    main-is:          Main.hs
